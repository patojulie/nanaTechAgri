# Server Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database (TypeORM + PostgreSQL)
# En local : variables séparées ci-dessous.
# En production (Railway) : DATABASE_URL est fournie automatiquement par le service
# Postgres et prend le pas sur les variables séparées (voir src/database/typeorm.config.ts).
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=agri_db
# DATABASE_URL=postgresql://user:password@host:port/dbname
# DB_SSL=false

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=900
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRATION=604800
JWT_OFFLINE_AGENT_EXPIRATION=2592000

# Redis
REDIS_URL=redis://localhost:6379

# SMS/Notification Providers
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=your_africas_talking_api_key

# Cloudinary (hébergement des photos, et demain audio/vidéo) — format fourni tel quel
# par le tableau de bord Cloudinary, onglet "API Keys"
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Swagger Documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=api/docs

# Logging
LOG_LEVEL=debug

# Monitoring
HEALTH_CHECK_ENABLED=true
